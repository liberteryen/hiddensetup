#!/usr/bin/env bash
set -euo pipefail

# Çıktı dosyası
OUT_FILE="./cryptsetup"

# cryptsetup binary yolu
CRYPTSETUP_BIN="$(command -v cryptsetup)"

if [[ -z "${CRYPTSETUP_BIN}" ]]; then
    echo "cryptsetup bulunamadı!"
    exit 1
fi

# ldd ile bağımlılıkları çek
mapfile -t LIBS < <(
    ldd "$CRYPTSETUP_BIN" \
        | awk '
            {
                for(i=1;i<=NF;i++) {
                    if ($i ~ /^\//) {
                        print $i
                    }
                }
            }
        ' \
        | sort -u
)

cat > "$OUT_FILE" <<EOF
build() {
    add_binary "/usr/bin/cryptsetup"
    add_module dm_mod
    add_module dm_crypt

    # Kernel crypto API for cryptsetup
    add_module af_alg
    add_module algif_skcipher
    add_module algif_hash
    add_module cryptd

    # Hash functions
    add_module sha256_generic
    add_module sha512_generic

    # Ciphers and block modes
    add_module aes_generic
    add_module aesni_intel
    add_module cbc
    add_module xts
    add_module ecb
    add_module serpent_generic
    add_module twofish_generic

    add_runscript
    add_binary /usr/bin/cryptsetup

EOF

# Dinamik add_file satırları
for lib in "${LIBS[@]}"; do
    echo "    add_file ${lib}" >> "$OUT_FILE"
done

cat >> "$OUT_FILE" <<'EOF'
}
EOF

chmod +x "$OUT_FILE"

echo "Install dosyası oluşturuldu: $OUT_FILE"
